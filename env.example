# Django Configuration for Local Development
# Copy this file to .env and modify as needed

# Enable debug mode for local development (defaults to False for production safety)
DEBUG=True
SECRET_KEY=kiu-journeys-local-dev-key-change-for-production-use
ALLOWED_HOSTS=localhost,127.0.0.1

# Production Configuration Example:
# DEBUG is False by default, so you can omit it for production
# SECRET_KEY=your-production-secret-key-with-50-characters-minimum-length
# ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,www.yourdomain.com
